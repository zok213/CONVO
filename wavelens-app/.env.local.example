# WaveLens Lite - Agora Configuration
# Copy this file to .env.local and fill in your Agora credentials.
# Get Agora credentials from https://console.agora.io -> Project Management

NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
NEXT_AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Optional: Agora Real-Time STT / translation REST credentials.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional: Solana devnet signer. JSON array of secret-key bytes.
SOLANA_PRIVATE_KEY=

# Optional: session telemetry webhook.
SESSION_WEBHOOK_URL=

# Optional: OpenAI-compatible proxy route.
NEXT_LLM_API_KEY=
NEXT_LLM_URL=
